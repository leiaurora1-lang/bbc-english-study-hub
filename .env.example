# OpenAI 兼容大模型配置（用于生成章节精讲、词汇、长难句、完形与测验）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
STUDYHUB_LLM_MODEL=gpt-4o-mini

# 语音转写配置（默认复用 OPENAI_API_KEY / OPENAI_BASE_URL；本地视频与无字幕 YouTube 使用）
STUDYHUB_ASR_API_KEY=
STUDYHUB_ASR_BASE_URL=
STUDYHUB_ASR_MODEL=whisper-1

# 服务监听端口
PORT=8000
